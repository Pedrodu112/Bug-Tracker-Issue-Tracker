# Copie para .env e substitua pelos dados liberados para sua conta.
# Para acessar a infraestrutura institucional, conecte a Forcepoint VPN.
# O usuário precisa de USAGE e CREATE no schema informado.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=SEU_SCHEMA"
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"
